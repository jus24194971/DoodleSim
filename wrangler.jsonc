{
  "name": "doodlesim",
  "compatibility_date": "2026-07-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doodlesim-antennas",
      "database_id": "4745ff68-3973-4a02-8f33-d79d41336494"
    }
  ]
}
